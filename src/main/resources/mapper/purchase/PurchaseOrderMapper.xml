<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="elec.shop.mapper.purchase.PurchaseOrderMapper">

    <!-- 采购订单VO结果映射 -->
    <resultMap id="PurchaseOrderVOResultMap" type="elec.shop.pojo.purchase.vo.PurchaserOrderVO">
        <id column="order_id" property="orderId" />
        <result column="order_no" property="orderNo" />
        <result column="user_id" property="userId" />
        <result column="shop_id" property="shopId" />
        <result column="cross_service" property="crossService" />
        <result column="purchaser_id" property="purchaserId" />
        <result column="real_name" property="purchaserName" />
        <result column="order_type" property="orderType" />
        <result column="order_status" property="orderStatus" />
        <result column="payment_status" property="paymentStatus" />
        <result column="real_total_amount" property="realTotalAmount" />
        <result column="total_amount" property="totalAmount" />
        <result column="currency" property="currency" />
        <result column="contact_phone" property="contactPhone" />
        <result column="state" property="state" />
        <result column="city" property="city" />
        <result column="postal_code" property="postalCode" />
        <result column="info_address" property="infoAddress" />
        <result column="info_address_bei" property="infoAddressBei" />
        <result column="reciver_person" property="reciverPerson" />
        <result column="exchange_rate" property="exchangeRate" />
        <result column="remark_order_no" property="remarkOrderNo" />
        <result column="remark" property="remark" />
        <result column="cancel_reason" property="cancelReason" />
        <result column="cancel_time" property="cancelTime" />
        <result column="confirm_time" property="confirmTime" />
        <result column="complete_time" property="completeTime" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="created_by" property="createdBy" />
        <result column="updated_by" property="updatedBy" />

        <!-- 关联查询订单商品明细 -->
        <collection property="orderItems" ofType="elec.shop.pojo.purchase.vo.PurchaserOrderItemVO">
            <id column="item_id" property="itemId" />
            <result column="product_name" property="productName" />
            <result column="product_link" property="productLink" />
            <result column="product_image" property="productImage" />
            <result column="sku" property="sku" />
            <result column="unit_price" property="unitPrice" />
            <result column="purchase_quantity" property="purchaseQuantity" />
        </collection>
    </resultMap>

    <resultMap id="BaseResultMap" type="elec.shop.pojo.purchase.PurchaseOrder">
            <id property="orderId" column="order_id" />
            <result property="orderNo" column="order_no" />
            <result property="userId" column="user_id" />
            <result property="shopId" column="shop_id" />
            <result property="purchaserId" column="purchaser_id" />
            <result property="orderType" column="order_type" />
            <result property="orderStatus" column="order_status" />
            <result property="paymentStatus" column="payment_status" />
            <result property="totalAmount" column="total_amount" />
            <result property="discountAmount" column="discount_amount" />
            <result property="actualAmount" column="actual_amount" />
            <result property="currency" column="currency" />
            <result property="exchangeRate" column="exchange_rate" />
            <result property="remarkOrderNo" column="remark_order_no" />
            <result property="remark" column="remark" />
            <result property="cancelReason" column="cancel_reason" />
            <result property="cancelTime" column="cancel_time" />
            <result property="confirmTime" column="confirm_time" />
            <result property="completeTime" column="complete_time" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
            <result property="deletedAt" column="deleted_at" />
            <result property="createdBy" column="created_by" />
            <result property="updatedBy" column="updated_by" />
            <result property="version" column="version" />
            <result property="tenantId" column="tenant_id" />
            <result property="isDeleted" column="is_deleted" />
    </resultMap>

    <sql id="Base_Column_List">
        order_id,order_no,user_id,shop_id,purchaser_id,order_type,
        order_status,payment_status,total_amount,discount_amount,actual_amount,
        currency,exchange_rate,remark_order_no,remark,cancel_reason,
        cancel_time,confirm_time,complete_time,created_at,updated_at,
        deleted_at,created_by,updated_by,version,tenant_id,
        is_deleted
    </sql>

    <select id="selectExportOrders" resultType="elec.shop.pojo.purchase.vo.PurchaserOrderExportVO">
        SELECT
            po.order_no,
            po.cross_service,
            si.shop_name,
            si.shop_code,
            pi.purchaser_code,
            po.service_charge,
            CASE po.order_type
                WHEN 1 THEN '普通采购'
                WHEN 2 THEN '紧急采购'
                WHEN 3 THEN '批量采购'
                ELSE '未知'
            END as order_type,
            po.contact_phone,
            po.state,
            po.city,
            po.postal_code,
            po.info_address,
            po.info_address_bei,
            po.reciver_person,
            CASE po.order_status
                WHEN 0 THEN '待确认'
                WHEN 1 THEN '已确认'
                WHEN 2 THEN '采购中'
                WHEN 3 THEN '已完成'
                WHEN 4 THEN '已取消'
                ELSE '未知'
            END as order_status,
            CASE po.payment_status
                WHEN 0 THEN '待支付'
                WHEN 1 THEN '已支付'
                WHEN 2 THEN '已退款'
                ELSE '未知'
            END as payment_status,
            po.total_amount,
            po.currency,
            po.exchange_rate,
            po.remark_order_no,
            po.remark,
            po.cancel_reason,
            po.cancel_time,
            po.confirm_time,
            po.complete_time,
            po.created_at,
            po.created_by,
            po.updated_at,
            po.updated_by,
            poi.product_name,
            poi.product_link,
            poi.product_image,
            poi.sku,
            poi.unit_price,
            poi.purchase_quantity
        FROM purchase_order po
        LEFT JOIN shop_info si ON po.shop_id = si.shop_id
        LEFT JOIN purchaser_info pi ON po.purchaser_id = pi.purchaser_id
        LEFT JOIN purchase_order_item poi ON po.order_id = poi.order_id
        WHERE po.is_deleted = 0
        <if test="userId != null">
            AND po.user_id = #{userId}
        </if>
        <if test="shopId != null">
            AND po.shop_id = #{shopId}
        </if>
        <if test="startTime != null and startTime != ''">
            AND po.created_at >= #{startTime}
        </if>
        <if test="endTime != null and endTime != ''">
            AND po.created_at &lt;= #{endTime}
        </if>
        ORDER BY po.created_at DESC, po.order_no, poi.item_id
    </select>
    <!-- 查询采购订单列表 -->
    <select id="queryPurchaseOrderList" resultMap="PurchaseOrderVOResultMap">
        SELECT
        po.*,
        poi.item_id,
        poi.product_name,
        poi.product_link,
        poi.product_image,
        poi.sku,
        poi.unit_price,
        poi.purchase_quantity
        FROM
        purchase_order po
        LEFT JOIN
        purchase_order_item poi ON po.order_id = poi.order_id
        WHERE
        po.is_deleted = 0
        <if test="queryDTO.shopId != null">
            AND po.shop_id = #{queryDTO.shopId}
        </if>
        <if test="queryDTO.orderStatus != null">
            AND po.order_status = #{queryDTO.orderStatus}
        </if>
        <if test="queryDTO.paymentStatus != null">
            AND po.payment_status = #{queryDTO.paymentStatus}
        </if>
        <if test="queryDTO.startTime != null and queryDTO.startTime != ''">
            AND po.created_at >= #{queryDTO.startTime}
        </if>
        <if test="queryDTO.endTime != null and queryDTO.endTime != ''">
            AND po.created_at &lt;= #{queryDTO.endTime}
        </if>
        ORDER BY
        -- 已取消的订单排在最后
        CASE WHEN po.order_status = 4 THEN 1 ELSE 0 END,
        -- 其他状态的订单按创建时间倒序排列
        po.created_at DESC
    </select>
    <select id="queryPurchaseOrderOne" resultMap="PurchaseOrderVOResultMap">
        SELECT
        po.*,
        su.real_name,
        poi.item_id,
        poi.product_name,
        poi.product_link,
        poi.product_image,
        poi.sku,
        poi.unit_price,
        poi.purchase_quantity
        FROM
        purchase_order po
        LEFT JOIN
        purchase_order_item poi ON po.order_id = poi.order_id
        LEFT JOIN
        purchaser_info pi ON po.purchaser_id = pi.purchaser_id
        LEFT JOIN
        sys_user su ON pi.user_id = su.user_id
        WHERE
        po.is_deleted = 0 and po.order_id = #{orderId}
    </select>

</mapper>
